# Beacon API edge. Cloudflare (proxied, SSL mode Full (strict)) → this Caddy → api:4000.
#
# TLS: a real Let's Encrypt certificate via HTTP-01. Cloudflare forwards
# http://<host>/.well-known/acme-challenge/* to the origin on port 80 even with
# "Always Use HTTPS" on (verified 2026-10-27 on this zone), so issuance and renewal work
# behind the proxy. TLS-ALPN-01 cannot work through Cloudflare, so it is disabled.
#
# Ports 80/443 accept only Cloudflare ranges (beacon-app SG), so the edge's
# CF-Connecting-IP is trusted for the client IP. Refresh the list below from
# https://www.cloudflare.com/ips-v4 and /ips-v6 if Cloudflare publishes new ranges.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

api.beacon.spacesdrive.cc {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	request_body {
		max_size 12MB
	}

	log {
		output stdout
		format json
	}

	header {
		-Server
		-Via
	}

	reverse_proxy api:4000 {
		# One clean hop for Express: app.set("trust proxy", 1) yields the real client IP.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
