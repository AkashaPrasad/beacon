# Rendered once on the standby's first boot to /opt/firecrawl/.env (mode 0600) by
# infra/terraform/files/firecrawl-bootstrap.sh. __PLACEHOLDERS__ are filled there;
# the Postgres password is generated on the host and never leaves it.
#
# Baseline = the "smallest working .env" from docs.firecrawl.dev/contributing/self-host
# (v2.11.162): USE_DB_AUTHENTICATION + POSTGRES_*. Upstream: "The root .env overrides
# only variables referenced by docker-compose.yaml" — every key below is referenced
# by /opt/firecrawl/docker-compose.yaml.

# ── Required baseline ────────────────────────────────────────────────
USE_DB_AUTHENTICATION=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# Keep "postgres": the bundled pg_cron config targets that database at v2.11.162.
POSTGRES_DB=postgres

# ── Listener ─────────────────────────────────────────────────────────
# PORT = host port published by compose; INTERNAL_PORT = the API's port in the container.
PORT=3002
INTERNAL_PORT=3002
HOST=0.0.0.0

# ── Internal services (compose network names) ────────────────────────
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# ── Image tag of ghcr.io/firecrawl/firecrawl (matches the cloned git ref) ─
FIRECRAWL_IMAGE_TAG=__FIRECRAWL_IMAGE_TAG__

# ── Concurrency sized for 2 vCPU / 8 GB (upstream defaults: 8 / 10 / 5 / 5) ─
NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=4
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3
BLOCK_MEDIA=true
HARNESS_STARTUP_TIMEOUT_MS=120000
LOGGING_LEVEL=INFO

# Leave NUQ_BACKEND and BULL_AUTH_KEY unset (Postgres queue, no admin UI).
