#cloud-config
# Beacon app box. Rendered by Terraform (templatefile) and gzipped; the
# bootstrap logic lives in infra/terraform/files/*.sh.
hostname: ${hostname}
preserve_hostname: false
package_update: false   # done by the bootstrap with lock timeouts + retries
package_upgrade: false

write_files:
  - path: /usr/local/lib/beacon/common.sh
    permissions: "0644"
    owner: root:root
    content: |
      ${indent(6, common_sh)}
  - path: /usr/local/lib/beacon/kc
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, kc)}
  - path: /usr/local/sbin/beacon-bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, bootstrap_sh)}
  - path: /etc/beacon/bootstrap.env
    permissions: "0644"
    owner: root:root
    content: |
      ROLE=app
      SWAP_MB=${swap_mb}

runcmd:
  - [bash, -c, "set -o pipefail; /usr/local/sbin/beacon-bootstrap.sh 2>&1 | tee -a /var/log/beacon-bootstrap.log"]
