{
  "name": "@kestrel/api",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon HTTP API (Express 5 + Mongoose).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "sync-seed": "node scripts/sync-seed.mjs",
    "dev:token": "tsx --env-file-if-exists=.env src/scripts/dev-token.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@kestrel/shared": "workspace:*",
    "ai": "7.0.154",
    "bcryptjs": "3.0.3",
    "bullmq": "6.5.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "sanitize-html": "2.18.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ioredis-mock": "8.2.8",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "docx": "9.14.0",
    "eslint": "10.13.0",
    "ioredis-mock": "8.13.1",
    "mongodb-memory-server": "11.3.0",
    "nock": "15.0.5",
    "pdf-lib": "1.17.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
