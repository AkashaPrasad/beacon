{
  "name": "@kestrel/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon background workers (BullMQ): ingest, extract, embed, match, ghostcheck, notify, cleanup.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@aws-sdk/client-ec2": "3.1156.0",
    "@huggingface/transformers": "4.3.1",
    "@kestrel/shared": "workspace:*",
    "ai": "7.0.154",
    "bullmq": "6.5.0",
    "entities": "8.1.0",
    "ioredis": "6.0.0",
    "luxon": "3.7.2",
    "mongoose": "9.11.4",
    "node-html-markdown": "2.0.0",
    "pino": "10.4.0",
    "robots-parser": "3.0.1",
    "rss-parser": "3.13.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/web-push": "3.6.4",
    "eslint": "10.13.0",
    "mongodb-memory-server": "11.3.0",
    "nock": "15.0.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
